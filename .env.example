# Copy to .env locally. Never commit actual values.
# data.go.kr decoding service key (not needed for synthetic demo data).
DATA_GO_KR_KEY=
# Required for first-time infrastructure deployment.
RG=
APP_NAME=airport
LOCATION=koreacentral
SWA_LOCATION=eastasia
ALERT_EMAIL=
# Optional Azure subscription; current CLI subscription is used if empty.
SUBSCRIPTION=
# Website hostname (without scheme), used for CORS on first deployment.
WEB_DOMAIN=
# Public URL and Blob data URL, supplied at web build/deployment time.
PUBLIC_SITE_URL=
DATA_BASE_URL=
# Optional search ownership verification tokens.
NAVER_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# Optional web-only deployment without Azure CLI resource discovery.
SWA_CLI_DEPLOYMENT_TOKEN=
# Optional principal to receive deployment permissions during provisioning.
DEPLOYER_PRINCIPAL_ID=
DEPLOYER_PRINCIPAL_TYPE=User
